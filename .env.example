# ==========================================
# LMS PRODUCTION ENVIRONMENT CONFIGURATION
# ==========================================

# Django Backend Settings
SECRET_KEY=your-production-django-secret-key-at-least-50-chars
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1,.railway.app,.up.railway.app

# Database (PostgreSQL provided automatically by Railway as DATABASE_URL)
DATABASE_URL=postgresql://postgres:password@localhost:5432/lms_db

# CORS & CSRF Settings (Include your Railway frontend domain)
CORS_ALLOWED_ORIGINS=http://localhost:3000,https://your-frontend.up.railway.app
CSRF_TRUSTED_ORIGINS=http://localhost:3000,https://your-frontend.up.railway.app,https://your-backend.up.railway.app

# Celery & Redis Cache (Provided automatically by Railway Redis)
REDIS_URL=redis://localhost:6379/0

# SimpleJWT Authentication
JWT_SECRET_KEY=your-production-jwt-secret-key

# Email Integration (SMTP)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=your-email@example.com
EMAIL_HOST_PASSWORD=your-app-password
EMAIL_USE_TLS=True

# Frontend Environment Variables (Set in Railway Frontend Service)
VITE_API_URL=https://your-backend.up.railway.app/api
